generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  TEAM
  ORGANIZER
  JUDGE
  PARTICIPANT
}

enum UserStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum EventStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentType {
  TICKET
  VOTE
  MERCH
}

enum PaymentStatus {
  PENDING
  SETTLED
  FAILED
  REFUNDED
}

model User {
  id                 String                @id @default(cuid())
  name               String
  email              String                @unique
  googleId           String?               @unique
  phone              String?               @unique
  passwordHash       String?
  institution        String?
  eventName          String?
  passwordResetTokenHash String?           @unique
  passwordResetExpiresAt DateTime?
  authVersion        Int                   @default(0)
  role               UserRole              @default(PARTICIPANT)
  status             UserStatus            @default(PENDING)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  organizedEvents    Event[]               @relation("EventOrganizer")
  registrations      EventRegistration[]
  payments           Payment[]
  judgeAssignments   JudgeAssignment[]
  scores             CompetitionScore[]

  @@index([status, role])
}

model Event {
  id                 String              @id @default(cuid())
  organizerId        String
  organizer          User                @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  name               String
  institution        String
  description        String              @default("")
  posterUrl          String              @default("")
  startsAt           DateTime?
  endsAt             DateTime?
  location           String              @default("")
  status             EventStatus         @default(PENDING)
  ticketPrice        Int                 @default(0)
  votePrice          Int                 @default(1000)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  registrations      EventRegistration[]
  payments           Payment[]
  schedules          EventSchedule[]
  criteria           ScoringCriterion[]
  judgeAssignments   JudgeAssignment[]
  scores             CompetitionScore[]

  @@index([status, startsAt])
  @@index([organizerId])
}

model EventRegistration {
  id                 String             @id @default(cuid())
  eventId            String
  event              Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId             String?
  user               User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  participantName    String
  teamName           String             @default("")
  status             RegistrationStatus @default(PENDING)
  createdAt          DateTime           @default(now())
  payments           Payment[]
  scores             CompetitionScore[]

  @@unique([eventId, participantName])
  @@index([eventId, status])
}

model EventSchedule {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  startsAt  DateTime
  endsAt    DateTime?
  createdAt DateTime @default(now())

  @@unique([eventId, startsAt])
  @@index([eventId, startsAt])
}

model ScoringCriterion {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  weight    Float    @default(1)
  minScore  Float    @default(0)
  maxScore  Float    @default(100)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  scores    CompetitionScore[]

  @@unique([eventId, name])
  @@index([eventId, active])
}

model JudgeAssignment {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  judgeId   String
  judge     User     @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([eventId, judgeId])
  @@index([judgeId, eventId])
}

model CompetitionScore {
  id             String           @id @default(cuid())
  eventId        String
  event          Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrationId String
  registration   EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  criterionId    String
  criterion      ScoringCriterion @relation(fields: [criterionId], references: [id], onDelete: Restrict)
  judgeId        String
  judge          User             @relation(fields: [judgeId], references: [id], onDelete: Restrict)
  value          Float
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([registrationId, criterionId, judgeId])
  @@index([eventId, registrationId])
  @@index([eventId, criterionId])
}

model Product {
  id                 String       @id @default(cuid())
  name               String
  description        String       @default("")
  imageUrl           String       @default("")
  price              Int
  stock              Int          @default(0)
  active             Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  payments           Payment[]
}

model Payment {
  id                 String        @id @default(cuid())
  orderId            String        @unique
  userId             String
  user               User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  type               PaymentType
  status             PaymentStatus @default(PENDING)
  amount             Int
  quantity           Int           @default(1)
  eventId            String?
  event              Event?        @relation(fields: [eventId], references: [id], onDelete: SetNull)
  registrationId     String?
  registration       EventRegistration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  productId          String?
  product            Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  midtransTransactionId String?
  createdAt          DateTime      @default(now())
  settledAt          DateTime?

  @@index([userId, createdAt])
  @@index([type, status])
}
