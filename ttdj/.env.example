# Copy to .env for local development. Replace all example credentials.
PORT=3000
APP_URL=https://rekapbaris.com
COOKIE_SECURE=true
JWT_SECRET=replace-with-a-random-secret-min-32-chars

# Example for a local PostgreSQL database; URL-encode special characters in passwords.
DATABASE_URL=postgresql://postgres:Bangazis1010@localhost:5432/rekapbaris?schema=public

GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CALLBACK_URL=https://rekapbaris.com/api/auth/google/callback

MIDTRANS_SERVER_KEY=your-midtrans-sandbox-server-key
MIDTRANS_CLIENT_KEY=your-midtrans-sandbox-client-key
MIDTRANS_IS_PRODUCTION=false

ADMIN_NAME=Admin Rekap Baris
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=+6281111111111
ADMIN_PASSWORD=replace-with-a-unique-random-password-min-8-chars
TEAM_NAME=Tim Rekap
TEAM_EMAIL=team@example.com
TEAM_PHONE=+6282222222222
TEAM_PASSWORD=replace-with-a-different-random-password-min-8-chars

# Public chat contact shown in the floating WhatsApp button; use digits with country code, no plus.
VITE_ADMIN_WHATSAPP=6281111111111

# Fonnte API token for password reset delivery. Keep this secret on the server only.
FONNTE_TOKEN=
