{
  "name": "rekapbaris-web",
  "version": "2.0.0",
  "private": true,
  "description": "Platform manajemen event, voting, dan ticketing Rekap Baris",
  "main": "server.js",
  "engines": {
    "node": ">=18.18 <25"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "nodemon server.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server.js",
    "db:generate": "prisma generate",
    "db:deploy": "prisma db push",
    "db:seed": "prisma db seed",
    "db:setup": "npm run db:generate && npm run db:deploy && npm run db:seed",
    "check": "node --check server.js && node --check prisma/seed.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "midtrans-client": "1.4.3",
    "@prisma/client": "6.19.0",
    "bcryptjs": "2.4.3",
    "cookie-parser": "1.4.7",
    "dotenv": "16.4.7",
    "express": "4.22.3",
    "express-rate-limit": "7.5.0",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.2",
    "nodemon": "3.1.9",
    "prisma": "6.19.0",
    "vite": "5.4.14",
    "lucide-react": "0.468.0"
  }
}
