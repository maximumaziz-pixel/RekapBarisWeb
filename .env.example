NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
SESSION_SECRET=ganti-dengan-random-rahasia-minimal-32-karakter
DATABASE_PATH=./data/rekapbaris.sqlite

# Buat akun admin/tim awal. Akun ini hanya dibuat saat pertama kali aplikasi berjalan.
ADMIN_NAME=Administrator RekapBaris
ADMIN_EMAIL=admin@rekapbaris.com
ADMIN_PASSWORD=ganti-dengan-password-admin-yang-kuat
TEAM_NAME=Tim Rekap
TEAM_EMAIL=tim@rekapbaris.com
TEAM_PASSWORD=ganti-dengan-password-tim-yang-kuat

# Google Identity Services: isi Client ID dari Google Cloud Console
GOOGLE_CLIENT_ID=

# Midtrans Snap. Gunakan Server Key; jangan pernah menaruh Server Key di frontend.
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
VOTE_PRICE=5000

# SMTP untuk email reset sandi
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=RekapBaris <noreply@rekapbaris.com>
